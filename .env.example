APP_NAME=MEHARA
AUTH_DEMO_MODE=false
AUTH_DEMO_PASSWORD=
AUTH_DEMO_STUDENT_EMAIL=student01@example.test
AUTH_DEMO_INSTRUCTOR_EMAIL=instructor01@example.test
AUTH_DEMO_ADMIN_EMAIL=admin01@example.test
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
VITE_API_URL=/api
FRONTEND_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=lms_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mehara.test"
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_VERIFICATION_EXPIRE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Exported Spline Public URLs or prod.spline.design/*/scene.splinecode URLs.
# Editor app.spline.design/file/* links are intentionally rejected at runtime.
VITE_SPLINE_HERO_URL=
VITE_SPLINE_ACTIVITIES_URL=

# Google Identity Services. Keep the secret server-side; only the client ID is public.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
